# Optional: enables live analysis in the web app via IBM watsonx.ai (Granite models only).
# Copy to .env.local (never commit it). Without these, the app shows recorded Bob IDE runs.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
